            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>id_reserva</leftvalue>
            <function>=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>9</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>id_reserva</leftvalue>
