    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>id_reserva</leftvalue>
            <function>=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>4</text>
              <length>-1</length>
