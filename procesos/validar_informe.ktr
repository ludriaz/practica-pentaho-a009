  <attributes />
  <step>
    <name>Leer informe</name>
    <type>CsvInput</type>
    <description />
    <distribute>N</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../temporal/informe_hotel_canal.csv</filename>
    <filename_field />
    <rownum_field />
    <include_filename>N</include_filename>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>hotel</name>
        <type>String</type>
        <format />
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <length>50</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>canal</name>
        <type>String</type>
        <format />
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <length>30</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>n_reservas</name>
        <type>Integer</type>
        <format>0</format>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>cobrado_total</name>
        <type>Number</type>
        <format>0.00</format>
        <currency />
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>2</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes />
    <cluster_schema />
    <remotesteps>
      <input />
      <output />
    </remotesteps>
    <GUI>
      <xloc>96</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Comprobar filas y valores</name>
    <type>FilterRows</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <send_true_to>Resumir informe</send_true_to>
    <send_false_to>Abortar por fila no valida</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>hotel</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue />
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>hotel</leftvalue>
            <function>&lt;&gt;</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>String</type>
              <text />
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>canal</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue />
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>canal</leftvalue>
            <function>&lt;&gt;</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>String</type>
              <text />
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>n_reservas</leftvalue>
            <function>&gt;=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>1</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>cobrado_total</leftvalue>
            <function>&gt;=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Number</type>
              <text>0</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
        </conditions>
      </condition>
    </compare>
    <attributes />
    <cluster_schema />
    <remotesteps>
      <input />
      <output />
    </remotesteps>
    <GUI>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Resumir informe</name>
    <type>GroupBy</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore />
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname />
    <give_back_row>Y</give_back_row>
    <group />
    <fields>
      <field>
        <aggregate>n_grupos</aggregate>
        <subject>hotel</subject>
        <type>COUNT_ALL</type>
        <valuefield />
      </field>
      <field>
        <aggregate>n_reservas</aggregate>
        <subject>n_reservas</subject>
        <type>SUM</type>
        <valuefield />
      </field>
      <field>
        <aggregate>cobrado_total</aggregate>
        <subject>cobrado_total</subject>
        <type>SUM</type>
        <valuefield />
      </field>
    </fields>
    <attributes />
    <cluster_schema />
    <remotesteps>
      <input />
      <output />
    </remotesteps>
    <GUI>
      <xloc>560</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Comprobar totales</name>
    <type>FilterRows</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <send_true_to>Informe correcto</send_true_to>
    <send_false_to>Abortar por totales incorrectos</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>n_grupos</leftvalue>
            <function>=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>13</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <leftvalue>n_reservas</leftvalue>
            <function>=</function>
            <rightvalue />
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>15</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
